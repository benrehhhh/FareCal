# FareCal environment configuration
# Copy this file to .env and fill in YOUR values. Do not commit .env to GitHub.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=farecal_db
DB_USER=root
DB_PASSWORD=

# Used only by database\setup_db.py to create the default administrator.
ADMIN_EMAIL=admin@farecal.ph
ADMIN_PASSWORD=admin123
ADMIN_NAME=FareCal Administrator