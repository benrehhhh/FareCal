# FareCal environment configuration
# Copy this file to .env and fill in YOUR values. Do not commit .env to GitHub.

FLASK_ENV=development
# Must be a strong random string in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Set to true when running behind HTTPS (Render / Railway / PythonAnywhere)
SESSION_COOKIE_SECURE=false

# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=farecal_db
DB_USER=root
DB_PASSWORD=

# Fare calculator limits
MAX_DISTANCE_KM=500